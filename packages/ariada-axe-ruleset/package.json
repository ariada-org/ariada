    "@ariada-org/wcag-rules-extended": "workspace:*"
  },
  "peerDependencies": {
    "axe-core": "^4"
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "engines": { "node": ">=22" }
}
