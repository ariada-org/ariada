{
  "name": "@ariada-org/axe-ruleset",
  "version": "0.1.0",
  "description": "Axe-core configuration payload for Ariada's existing WCAG rules and checks.",
  "license": "EUPL-1.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
