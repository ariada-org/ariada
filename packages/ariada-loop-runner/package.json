{
  "name": "@ariada-org/loop-runner",
  "version": "0.1.1",
  "description": "Runs the repository against its own content-policy gate: turns a gate failure into an attribution, a remediation plan, and a recorded result.",
  "license": "EUPL-1.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist coverage",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@ariada-org/ai-authorship": "workspace:*",
    "@ariada-org/content-policy": "workspace:*",
    "@ariada-org/diff-schema": "workspace:*",
    "@ariada-org/reverter-adapter": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": {
    "name": "Alexander Brichkin (Agonist Development AB)",
    "email": "git@ariada.org"
  }
}
