{
  "name": "@ariada-org/selenium-ariada",
  "version": "0.1.2",
  "description": "Selenium CDP accessibility-tree and axe adapter with Ariada CLI fallback.",
  "license": "EUPL-1.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scan-adapter": {
      "types": "./dist/scan-adapter.d.ts",
      "import": "./dist/scan-adapter.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ariada-org/cli": "workspace:*",
    "axe-core": "^4.10.0"
  },
  "peerDependencies": {
    "selenium-webdriver": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "selenium-webdriver": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
