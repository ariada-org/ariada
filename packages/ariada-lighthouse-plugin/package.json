{
  "name": "@ariada-org/lighthouse-plugin",
  "version": "0.1.0",
  "description": "Lighthouse plugin that adapts configured Ariada scan output into conformance audits.",
  "license": "EUPL-1.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./audits/conformance.js": { "types": "./dist/audits/conformance.d.ts", "import": "./dist/audits/conformance.js" },
    "./audits/high-impact.js": { "types": "./dist/audits/high-impact.d.ts", "import": "./dist/audits/high-impact.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "lighthouse": "^13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "lighthouse": "^13.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "engines": { "node": ">=22" }
}
