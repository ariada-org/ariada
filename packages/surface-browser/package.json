{
  "name": "@ariada-org/surface-browser",
  "version": "0.1.0",
  "description": "In-browser surface adapter for @ariada-org/core-engine — bookmarklet, DevTools panel entry point, and importable ES module for multi-domain compliance scanning in any browser context.",
  "license": "EUPL-1.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/panel.html",
    "README.md",
    "LICENSE",
    "LICENSES",
    "NOTICE",
    "REUSE.toml",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bundle:size": "esbuild src/bookmarklet-entry.ts --bundle --minify --format=iife --target=es2022 --outfile=bundle-bookmarklet.min.js && node -e \"const fs=require('fs');const s=fs.statSync('bundle-bookmarklet.min.js').size;console.log('Bookmarklet bundle size:',s,'bytes');if(s>50000){console.error('FAIL: exceeds 50 KB limit (',s,'bytes)');process.exit(1);}else{console.log('PASS: within 50 KB limit');}\"",
    "clean": "rimraf dist coverage bundle-bookmarklet.min.js test-results playwright-report"
  },
  "dependencies": {
    "@ariada-org/core-browser": "workspace:*",
    "@ariada-org/core-engine": "workspace:*"
  },
  "devDependencies": {
    "@ariada-org/test-fixtures": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.9.0",
    "playwright": "^1.60.0",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariada-org/ariada.git",
    "directory": "packages/surface-browser"
  },
  "homepage": "https://ariada.org/packages/surface-browser",
  "bugs": {
    "url": "https://github.com/ariada-org/ariada/issues"
  },
  "author": {
    "name": "Alekszandr Bricskin (Agonist Development AB)",
    "email": "git@ariada.org",
    "url": "https://ariada.org"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "eaa",
    "browser",
    "bookmarklet",
    "devtools",
    "compliance",
    "scanner",
    "eupl"
  ]
}
