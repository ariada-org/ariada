  },
  "devDependencies": {
    "@ariada-org/core-playwright": "workspace:*",
    "playwright": "^1.60.0",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariada-org/ariada.git",
    "directory": "packages/rules-axe"
