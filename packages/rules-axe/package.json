  "description": "Compatibility re-export of the axe-core analyzer, which now ships in @ariada-org/core-playwright.",
  "license": "EUPL-1.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
