{
  "name": "@ariada-org/angular-builder",
  "version": "0.1.0",
  "description": "Angular CLI builder and schematic helpers for scanning build output with Ariada.",
  "license": "EUPL-1.2",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "builders": "./builders.json",
  "schematics": "./collection.json",
  "files": [
    "dist",
    "builders.json",
    "collection.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@ariada-org/vite-plugin": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "angular",
    "builder",
    "schematic",
    "accessibility",
    "ariada"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
