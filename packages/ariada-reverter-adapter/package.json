{
  "name": "@ariada-org/reverter-adapter",
  "version": "0.1.0",
  "description": "Webhook adapter for the accessibility fix-PR integration — parses check_run and deployment_status events, converts findings into clusters, and calls the hosted remediation cascade endpoint. Internal package.",
  "license": "EUPL-1.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "echo 'no end-to-end tests in this package' && exit 0",
    "clean": "rimraf dist coverage",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@ariada-org/diff-schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "fix-pr",
    "github-app",
    "vercel-integration",
    "eupl"
  ],
  "homepage": "https://ariada.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariada-org/ariada.git",
    "directory": "packages/ariada-reverter-adapter"
  },
  "bugs": {
    "url": "https://github.com/ariada-org/ariada/issues"
  },
  "author": {
    "name": "Alekszandr Bricskin (Agonist Development AB)",
    "email": "git@ariada.org",
    "url": "https://ariada.org"
  }
}
