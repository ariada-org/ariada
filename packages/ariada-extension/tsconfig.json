{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts", "scripts/**/*.mjs", "tests/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
