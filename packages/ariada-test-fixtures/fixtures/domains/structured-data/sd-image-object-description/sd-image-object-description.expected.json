{
  "domain": "structured-data",
  "rule": "sd-image-object-description",
  "standard": ["Schema.org ImageObject — description property (schema.org/ImageObject)"],
  "cases": [
    {
      "id": "fail-1",
      "selector": "img[src=\"photo-product.jpg\"]",
      "expect": "fail",
      "severity": "moderate",
      "why": "ImageObject block with contentUrl='photo-product.jpg' has no description property; selector resolves to the matching img element via contentUrl"
    },
    {
      "id": "fail-2",
      "selector": "script[type=\"application/ld+json\"]:nth-of-type(2)",
      "expect": "fail",
      "severity": "moderate",
      "why": "ImageObject block with no contentUrl and no description; selector falls back to the nth-of-type script position"
    },
    {
      "id": "pass-1",
      "selector": "script[type=\"application/ld+json\"]:nth-of-type(3)",
      "expect": "pass"
    }
  ],
  "alsoExpect": []
}
