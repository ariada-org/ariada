{
  "domain": "accessibility",
  "rule": "ariada/audiovisual/media-element-has-accessible-name",
  "standard": ["WCAG 2.2 SC 4.1.2", "EN 301 549 9.4.1.2", "EAA Annex I §I.6"],
  "cases": [
    {
      "id": "fail-1",
      "selector": "#fail-1 video",
      "expect": "fail",
      "severity": "serious",
      "why": "video[controls] has no aria-label, no title, no aria-labelledby; name resolves to empty"
    },
    {
      "id": "fail-2",
      "selector": "#fail-2 audio",
      "expect": "fail",
      "severity": "serious",
      "why": "audio[controls] has no accessible name — screen reader announces only 'audio'"
    },
    {
      "id": "pass-1",
      "selector": "#pass-1 video",
      "expect": "pass"
    },
    {
      "id": "pass-2",
      "selector": "#pass-2 audio",
      "expect": "pass"
    },
    {
      "id": "pass-3",
      "selector": "#pass-3 video",
      "expect": "pass"
    }
  ],
  "alsoExpect": [
    "ariada/audiovisual/video-has-captions-track",
    "ariada/audiovisual/video-has-audio-description-track"
  ]
}
