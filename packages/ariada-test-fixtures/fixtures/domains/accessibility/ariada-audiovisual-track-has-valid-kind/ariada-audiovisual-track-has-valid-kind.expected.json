      "selector": "#fail-2",
      "expect": "fail",
      "severity": "minor",
      "why": "kind='subtitles' is valid but srclang is absent; spec requires srclang for subtitles"
    },
    {
      "id": "fail-3",
      "selector": "#fail-3",
      "expect": "fail",
      "severity": "minor",
      "why": "absent kind defaults to 'subtitles'; no srclang present — same srclang requirement applies"
    },
    {
      "id": "pass-1",
      "selector": "#pass-1",
      "expect": "pass"
    },
    {
      "id": "pass-2",
      "selector": "#pass-2",
      "expect": "pass"
    }
  ],
  "alsoExpect": ["ariada/audiovisual/captions-track-has-src"]
