{
  "name": "@ariada-org/test-fixtures",
  "version": "0.2.0",
  "description": "Curated HTML fixtures + golden snapshots for accessibility rule testing — generic axe-core cases plus EU real-world patterns (Klarna/BankID/MobilePay/Mittelstand/RGAA). HTML fixtures dedicated to the public domain (CC0-1.0); fixture-server source code under EUPL-1.2.",
  "license": "CC0-1.0 AND EUPL-1.2",
  "type": "module",
  "main": "./dist/serve.js",
  "types": "./dist/serve.d.ts",
  "exports": {
    ".": {
      "types": "./dist/serve.d.ts",
      "import": "./dist/serve.js"
    },
    "./multi-root-server": {
      "types": "./dist/multi-root-server.d.ts",
      "import": "./dist/multi-root-server.js"
    },
    "./playwright-base": {
      "types": "./dist/playwright-base-config.d.ts",
      "import": "./dist/playwright-base-config.js"
    },
    "./playwright-fixture-generic-eu": {
      "types": "./dist/playwright-fixture-generic-eu.d.ts",
      "import": "./dist/playwright-fixture-generic-eu.js"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "@playwright/test": "^1.60.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0",
    "eslint": "^9.17.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "test-fixtures",
    "axe-core",
    "html",
    "klarna",
    "bankid",
    "mobilepay",
    "rgaa",
    "eu",
    "eupl"
  ],
  "homepage": "https://ariada.org/packages/test-fixtures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariada-org/ariada.git",
    "directory": "packages/ariada-test-fixtures"
  },
  "bugs": {
    "url": "https://github.com/ariada-org/ariada/issues"
  },
  "author": {
    "name": "Alekszandr Bricskin (Agonist Development AB)",
    "email": "git@ariada.org",
    "url": "https://ariada.org"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
