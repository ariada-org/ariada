{
  "name": "@ariada/scan-report-html",
  "version": "0.1.0",
  "description": "Renders machine-readable accessibility scan artefacts into a single self-contained human-readable HTML report. Closes the gap between scan-results.json and what an auditor / developer / compliance officer can actually read.",
  "license": "EUPL-1.2",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "REUSE.toml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "test:mutation:report": "open reports/mutation/mutation.html",
    "clean": "rimraf dist coverage reports .stryker-tmp"
  },
  "dependencies": {
    "@ariada/core-engine": "workspace:*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag22",
    "axe-core",
    "scan-report",
    "html-report",
    "eaa",
    "eupl"
  ],
  "homepage": "https://ariada.org/packages/scan-report-html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariada-org/ariada.git",
    "directory": "packages/scan-report-html"
  },
  "bugs": {
    "url": "https://github.com/ariada-org/ariada/issues"
  },
  "author": {
    "name": "Alekszandr Bricskin (Agonist Development AB)",
    "email": "git@ariada.org",
    "url": "https://ariada.org"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
