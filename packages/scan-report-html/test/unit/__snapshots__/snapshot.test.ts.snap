        </div>
        
      </li>
      </ol>
      
      <p class="card__helpurl">
        Read the full rule:
        <a href="https://dequeuniversity.com/rules/axe/4.10/landmark-unique" target="_blank" rel="noopener noreferrer">https://dequeuniversity.com/rules/axe/4.10/landmark-unique<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in new tab)</span></a>
      </p>
    </div>
  </details>
</li>
  </ul>
</section>
    <section class="action-items" aria-labelledby="action-items-heading">
  <h2 id="action-items-heading">Top 5 action items</h2>
  <ol class="action-items__list">
    <li class="action-items__item">
