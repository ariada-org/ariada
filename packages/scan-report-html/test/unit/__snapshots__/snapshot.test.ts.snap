        </div>
        
      </li>
      </ol>
      
      <p class="card__helpurl">
        Read the full rule:
        <a href="https://dequeuniversity.com/rules/axe/4.10/region" target="_blank" rel="noopener noreferrer">https://dequeuniversity.com/rules/axe/4.10/region<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in new tab)</span></a>
      </p>
    </div>
  </details>
</li>
  <li class="card-item">
  <details class="card card--minor" open id="finding-5-landmark-unique">
    <summary class="card__summary" aria-describedby="finding-5-landmark-unique-title">
