{
  "name": "@ariada-org/wdio-ariada-service",
  "version": "0.1.1",
  "description": "WebdriverIO service and scan adapter for Ariada accessibility reports.",
  "license": "EUPL-1.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./scan-adapter": {
      "types": "./dist/scan-adapter.d.ts",
      "import": "./dist/scan-adapter.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ariada-org/cli": "workspace:*",
    "@ariada-org/core-engine": "workspace:*"
  },
  "peerDependencies": {
    "@wdio/types": "^9.0.0",
    "webdriverio": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@wdio/types": "^9.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^7.0.2",
    "webdriverio": "^9.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
