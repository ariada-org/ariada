# Vulnerability ignore policy — currently empty.
# When a vuln must be ignored, add under `ignore:` with the format:
#
# ignore:
#   SNYK-JS-MINIMIST-123456:
#     - '* > minimist':
#         reason: 'Affected path not reachable from public API'
#         expires: '2026-12-31T00:00:00.000Z'
ignore: {}

# Patch policy — currently empty.
patch: {}
