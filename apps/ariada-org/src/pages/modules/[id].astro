---
import Base from '../../layouts/Base.astro';
import snapshot from '../../../public/channel-matrix.json';

type SnapshotChannel = (typeof snapshot.channels)[number];

export function getStaticPaths() {
  return snapshot.channels.map((channel) => ({
    params: { id: channel.id.toLowerCase() },
    props: { channel },
  }));
}

const { channel } = Astro.props as { channel: SnapshotChannel };
const publicUrl = (value: string | null) => {
  if (!value) return null;
  try {
    const url = new URL(value);
    return url.protocol === 'https:' && Boolean(url.hostname) ? url.toString() : null;
  } catch {
    return null;
  }
};
const requiredPublicUrl = (value: string, field: string) => {
  const url = publicUrl(value);
  if (!url) throw new Error(channel.id + ' has an invalid ' + field + '.');
  return url;
};

const canonicalUrl = 'https://ariada.org/modules/' + channel.id.toLowerCase() + '/';
const description = channel.description;
const deliveryStatus = channel.state;
const codeUrl = publicUrl(channel.publicCodeUrl);
const developmentEvidenceUrl = publicUrl(channel.developmentEvidenceUrl);
const deliveryEvidenceUrls = channel.deliveryEvidenceUrls
  .map((url) => publicUrl(url))
  .filter((url): url is string => Boolean(url));
const productionEvidenceUrl = publicUrl(channel.evidenceUrl);
const moduleUrl = requiredPublicUrl(channel.ariadaModuleUrl, 'ariadaModuleUrl');
const wikiUrl = requiredPublicUrl(channel.wikiUrl, 'wikiUrl');
const hasEvidence = Boolean(
  developmentEvidenceUrl ||
  deliveryEvidenceUrls.length ||
  productionEvidenceUrl
);
const evidenceSummary = productionEvidenceUrl
  ? 'Production evidence declared'
  : deliveryEvidenceUrls.length
    ? deliveryEvidenceUrls.length + ' delivery evidence links declared'
    : developmentEvidenceUrl
      ? 'Development evidence declared'
      : 'No public evidence declared';
const noEvidenceMessage = deliveryStatus === 'Planned'
  ? 'No public evidence is declared for this planned module.'
  : deliveryStatus === 'In development'
    ? 'No public development evidence URL is declared yet.'
    : deliveryStatus === 'Delivered'
      ? 'No public delivery evidence URL is declared.'
      : 'No public production evidence URL is declared.';
const updatedAt = channel.updatedAt;
const changed = updatedAt
  ? new Intl.DateTimeFormat('en', {
      dateStyle: 'full',
      timeStyle: 'long',
      timeZone: 'UTC',
    }).format(new Date(updatedAt))
  : null;
const organization = { '@type': 'Organization', name: 'Ariada', url: 'https://ariada.org/' };
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': canonicalUrl,
  url: canonicalUrl,
  headline: channel.id + ' ' + channel.name,
  name: channel.id + ' ' + channel.name,
  description,
  dateModified: updatedAt ?? snapshot.generatedAt,
  author: organization,
  publisher: organization,
  inLanguage: 'en',
  availableLanguage: snapshot.wiki.locales,
  audience: channel.roles.map((role) => ({ '@type': 'Audience', audienceType: role })),
  sameAs: [
    wikiUrl,
    codeUrl,
    developmentEvidenceUrl,
    ...deliveryEvidenceUrls,
    productionEvidenceUrl,
  ].filter(Boolean),
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  about: {
    '@type': 'SoftwareApplication',
    name: channel.name,
    url: moduleUrl,
  },
  isPartOf: {
    '@type': 'CollectionPage',
    '@id': 'https://ariada.org/modules/',
    name: 'Ariada modules',
  },
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<Base
  title={channel.id + ' ' + channel.name + ' | Ariada'}
  description={channel.id + ' ' + channel.name + ': public status, roles, use cases, installation, evidence, source code, and Ariada Wiki guide.'}
>
  <script type="application/ld+json" set:html={structuredDataJson}></script>

  <article class="channel-evidence">
    <p class="eyebrow"><a href="/modules/">236-channel matrix</a> / Pack {channel.pack}</p>
    <h1><code>{channel.id}</code> {channel.name}</h1>
    <p class="lead">{description}</p>
    <p class="provenance">
      This page renders only the fields declared by the sanitized public module catalog.
      Ariada is the module authority and the Ariada Wiki provides the detailed guide.
    </p>

    <dl class="facts">
      <div><dt>Delivery status</dt><dd>{deliveryStatus}</dd></div>
      <div><dt>Public code</dt><dd>{codeUrl ? 'Public URL declared' : 'Not publicly delivered'}</dd></div>
      <div><dt>Evidence</dt><dd>{evidenceSummary}</dd></div>
      <div><dt>Installation</dt><dd>{channel.installation}</dd></div>
      <div>
        <dt>Last public update</dt>
        <dd>
          {updatedAt && changed
            ? <time datetime={updatedAt}>{changed} UTC</time>
            : 'No public update date'}
        </dd>
      </div>
      <div><dt>Snapshot</dt><dd><code>{snapshot.snapshotHash}</code></dd></div>
    </dl>

    <div class="content-grid">
      <section aria-labelledby="what-it-does">
        <h2 id="what-it-does">What it does</h2>
        <p>{description}</p>
      </section>

      <section aria-labelledby="who-uses-it">
        <h2 id="who-uses-it">Who uses it / roles</h2>
        <ul>{channel.roles.map((role) => <li>{role}</li>)}</ul>
      </section>

      <section aria-labelledby="use-cases">
        <h2 id="use-cases">Use cases</h2>
        <ul>{channel.useCases.map((useCase) => <li>{useCase}</li>)}</ul>
      </section>

      <section aria-labelledby="installation">
        <h2 id="installation">Installation</h2>
        <p>{channel.installation}</p>
      </section>

      <section aria-labelledby="deployment-status">
        <h2 id="deployment-status">Deployment status</h2>
        <strong class="status-label">{deliveryStatus}</strong>
        <p><code>{channel.deploymentStatus}</code></p>
      </section>

      <section aria-labelledby="distribution-status">
        <h2 id="distribution-status">Distribution status</h2>
        <p><code>{channel.distributionStatus}</code></p>
      </section>

      <section aria-labelledby="source-code">
        <h2 id="source-code">Source code</h2>
        {codeUrl
          ? <a class="action" href={codeUrl}>Open public source code</a>
          : <p>No public source-code URL is declared for this module.</p>}
      </section>

      <section aria-labelledby="public-evidence">
        <h2 id="public-evidence">Public evidence</h2>
        {developmentEvidenceUrl &&
          <p data-evidence-kind="development">
            <a class="action" href={developmentEvidenceUrl}>Open development evidence</a>
          </p>}
        {deliveryEvidenceUrls.length > 0 &&
          <div data-evidence-kind="delivery">
            <h3>Delivery evidence</h3>
            <ul>
              {deliveryEvidenceUrls.map((url, index) =>
                <li><a href={url}>Delivery evidence {index + 1}</a></li>
              )}
            </ul>
          </div>}
        {productionEvidenceUrl &&
          <p data-evidence-kind="production">
            <a class="action" href={productionEvidenceUrl}>Open production evidence</a>
          </p>}
        {!hasEvidence && <p data-evidence-empty>{noEvidenceMessage}</p>}
      </section>

      <section aria-labelledby="detailed-guide">
        <h2 id="detailed-guide">Detailed guide in Ariada Wiki</h2>
        <a class="action" href={wikiUrl}>Open detailed guide</a>
      </section>
    </div>

    <p class="back"><a href="/modules/">Return to the complete matrix</a></p>
  </article>
</Base>

<style>
  .channel-evidence { max-width: 72rem; margin: 0 auto; padding: 2.5rem 0 3rem; }
  .eyebrow { color: var(--muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .eyebrow a, .back a { color: var(--fg); }
  h1 { max-width: 18ch; margin: 1rem 0; font-size: clamp(2.4rem, 7vw, 6rem); line-height: 0.95; letter-spacing: -0.055em; }
  h1 code { color: var(--accent); font-size: 0.45em; letter-spacing: 0; }
  .lead { max-width: 66ch; color: var(--muted); font-size: 1.1rem; line-height: 1.65; }
  .provenance { max-width: 76ch; color: var(--muted); font-size: 0.85rem; line-height: 1.6; }
  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 3rem 0; border-top: 1px solid var(--border); border-left: 1px solid var(--border); }
  .facts div { min-height: 8rem; padding: 1rem; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  dt { color: var(--muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; }
  dd { margin: 1rem 0 0; overflow-wrap: anywhere; }
  .content-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--border); border-left: 1px solid var(--border); }
  section { min-height: 15rem; margin: 0; padding: 1.5rem; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  section h2 { margin: 0 0 1rem; font-size: 1.25rem; }
  section h3 { margin: 1rem 0 0.5rem; font-size: 1rem; }
  section p, section li { color: var(--muted); line-height: 1.65; overflow-wrap: anywhere; }
  section ul { padding-left: 1.2rem; }
  pre { max-width: 100%; overflow-x: auto; border: 1px solid var(--border); padding: 0.8rem; background: var(--bg-elevated, var(--bg)); }
  .status-label { display: inline-block; border: 1px solid var(--border); padding: 0.3rem 0.5rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.72rem; text-transform: uppercase; }
  .action { display: inline-flex; margin: 0.5rem 0.75rem 0.5rem 0; border: 1px solid var(--fg); padding: 0.7rem 0.9rem; color: var(--fg); font-weight: 700; text-decoration: none; }
  .action:hover, .action:focus-visible { background: var(--fg); color: var(--bg); }
  .back { margin-top: 4rem; }

  @media (max-width: 720px) {
    .facts, .content-grid { grid-template-columns: 1fr; }
    section { min-height: auto; }
  }
</style>
