---
// SPDX-FileCopyrightText: 2026 Alexander Brichkin (Agonist Development AB)
// SPDX-License-Identifier: EUPL-1.2
//
// /demo — public multi-domain compliance report demonstration.
//
// Renders a pre-computed MultiDomainReport for 3 sites (2 EU public-sector
// sites with differing compliance posture + 1 open-source docs reference).
// The fixture lives at public/demo/multi-domain-report.json and is refreshed
// by running scripts/generate-demo-fixtures.sh.
//
// No client-side JavaScript. Pure static Astro build.

import type { MultiDomainReport } from "@ariada-org/core-engine";
import Base from "../layouts/Base.astro";
import MultiDomainComparison from "../components/MultiDomainComparison.astro";

// Vite handles JSON imports at build time. The path is relative to this file
// (src/pages/demo.astro → ../../public/demo/multi-domain-report.json).
// Using a direct import ensures the fixture is bundled at build time and the
// path resolves correctly in the prerender context.
import reportRaw from "../../public/demo/multi-domain-report.json";
const report = reportRaw as unknown as MultiDomainReport;
---

<Base
  title="Ariada multi-domain compliance report — live demo"
  description="A real multi-domain compliance report produced by a single DOM pass across 3 sites and 2 compliance areas. Demonstrates cross-domain interaction detection and cross-site divergence analysis."
>
  <section aria-labelledby="demo-heading">
    <h1 id="demo-heading">Ariada multi-domain compliance report</h1>
    <p class="lede">
      The report below was produced by a single shared DOM traversal across{" "}
      {report.sites.length} sites and {report.domains.length} compliance
      domains. Each compliance domain registers feature extractors into the
      same walker — adding a domain adds zero additional DOM passes.
    </p>
    <p class="lede">
      This page is a static build of a pre-computed fixture. No live scanning
      runs on page load.
    </p>
  </section>

  <section aria-labelledby="report-heading">
    <h2 id="report-heading" class="sr-only">Report</h2>
    <MultiDomainComparison
      report={report}
      scanDate="2026-06-16"
    />
  </section>
</Base>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .lede {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--muted);
    margin-bottom: 1rem;
  }
</style>
