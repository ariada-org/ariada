---
import Base from "../layouts/Base.astro";

/*
 * ariada.org/about — maintainer and stewardship statement.
 *
 * Entity-light: maintainer name only. The full corporate-entity
 * disclosure appears only on /accessibility/ where DOS-lagen
 * self-certification requires it.
 *
 * patent-audit-skip: no-patent-text-on-page
 */
---

<Base
  title="About — ariada.org"
  description="ariada.org publishes the @ariada-org/* rule-pack family under EUPL-1.2. Maintained by Alexander Brichkin (Agonist Development AB)."
>
  <section>
    <h1>About</h1>
    <p>
      <strong>ariada.org</strong> publishes the
      <code>@ariada-org/*</code> rule-pack family &mdash; open-source rule
      expressions, contribution guidelines, and
      accessibility-statement primitives consumed by axe-core and any
      third-party scanner or audit pipeline that adopts the packs.
    </p>
    <p>
      Lead maintainer: Alexander Brichkin (Agonist Development AB,
      Sweden, org.nr 559452-5726). Contributions arrive via
      GitHub pull requests under EUPL-1.2. There are no analytics,
      tracking, or marketing surfaces on this site &mdash; contributors
      interact with the rule corpus without entering any funnel.
    </p>
  </section>
</Base>
