---
// SPDX-FileCopyrightText: 2026 Alexander Brichkin (Agonist Development AB)
// SPDX-License-Identifier: EUPL-1.2
//
// ariada.org/packages — the full open-source package catalog.
//
// Reads every packages/*/package.json in the monorepo at build time and
// lists the packages that are meant for public consumption (not marked
// `private` and carrying a real description), so this page never drifts
// out of sync with what actually ships. The same source of truth backs
// the module table in the GitHub README.

import { existsSync, readdirSync, readFileSync, statSync } from "node:fs";
import { join, resolve } from "node:path";
import Base from "../layouts/Base.astro";

function findMonorepoRoot(startDir: string): string {
  let dir = resolve(startDir);
  for (let i = 0; i < 10; i++) {
    if (existsSync(join(dir, "pnpm-workspace.yaml"))) return dir;
    const parent = resolve(dir, "..");
    if (parent === dir) break;
    dir = parent;
  }
  throw new Error("Could not locate monorepo root (pnpm-workspace.yaml) from " + startDir);
}

const packagesDir = join(findMonorepoRoot(process.cwd()), "packages");

function countTsLines(dir: string): number {
  let total = 0;
  try {
    for (const entry of readdirSync(dir, { withFileTypes: true })) {
      if (!entry.isDirectory()) continue;
      const sub = join(dir, entry.name);
      for (const f of readdirSync(sub)) {
        if (f.endsWith(".ts") && !f.endsWith(".d.ts")) {
          total += readFileSync(join(sub, f), "utf-8").split("\n").length;
        }
      }
    }
  } catch {}
  return total;
}

function countTests(dir: string): number {
  let count = 0;
  for (const sub of ["test", "tests"]) {
    const p = join(dir, sub);
    if (!existsSync(p)) continue;
    const walk = (d: string) => {
      for (const e of readdirSync(d, { withFileTypes: true })) {
        if (e.isDirectory()) walk(join(d, e.name));
        else if (e.name.endsWith(".test.ts") || e.name.endsWith(".spec.ts")) count++;
      }
    };
    walk(p);
  }
  return count;
}

interface PackageEntry {
  name: string;
  version: string;
  description: string;
  license: string;
  status: "shipped" | "built" | "stub";
  srcLines: number;
  testCount: number;
}

function loadPackages(): PackageEntry[] {
  const entries: PackageEntry[] = [];
  for (const dir of readdirSync(packagesDir, { withFileTypes: true })) {
    if (!dir.isDirectory()) continue;
    let raw: string;
    try {
      raw = readFileSync(`${packagesDir}/${dir.name}/package.json`, "utf-8");
    } catch {
      continue;
    }
    const pkg = JSON.parse(raw);
    const description = typeof pkg.description === "string" ? pkg.description.trim() : "";
    if (pkg.private === true) continue;
    if (description.length === 0) continue;

    const srcDir = join(packagesDir, dir.name, "src");
    const hasSrc = existsSync(srcDir);
    const srcLines = hasSrc ? countTsLines(srcDir) : 0;
    const testCount = countTests(join(packagesDir, dir.name));

    let status: PackageEntry["status"] = "stub";
    if (srcLines > 200 && testCount > 0) status = "shipped";
    else if (srcLines > 0) status = "built";

    entries.push({
      name: pkg.name ?? dir.name,
      version: pkg.version ?? "—",
      description,
      license: typeof pkg.license === "string" ? pkg.license : "—",
      status,
      srcLines,
      testCount,
    });
  }
  entries.sort((a, b) => {
    const order = { shipped: 0, built: 1, stub: 2 };
    return (order[a.status] - order[b.status]) || a.name.localeCompare(b.name);
  });
  return entries;
}

const packages = loadPackages();
const shipped = packages.filter(p => p.status === "shipped").length;
const built = packages.filter(p => p.status === "built").length;
const stubs = packages.filter(p => p.status === "stub").length;
---

<Base
  title="Packages — ariada.org"
  description={`Catalog of ${packages.length} open-source @ariada-org/* packages — what each one does and under which license. Generated from the monorepo at build time.`}
>
  <section>
    <h1>Packages</h1>
    <p class="lede">
      {packages.length} open-source packages from the
      <a href="https://github.com/ariada-org/ariada" rel="external">ariada-org/ariada</a>
      monorepo. Source of truth: each <code>package.json</code> + source tree, scanned at
      build time. {shipped} shipped, {built} built, {stubs} stub.
    </p>
  </section>

  <section aria-labelledby="catalog-heading">
    <h2 id="catalog-heading" class="sr-only">Package catalog</h2>
    <div class="table-scroll">
      <table>
        <caption class="sr-only">Every open-source package published from the ariada-org/ariada monorepo, with its license and what it does.</caption>
        <thead>
          <tr>
            <th scope="col">Package</th>
            <th scope="col">Version</th>
            <th scope="col">Status</th>
            <th scope="col">What it does</th>
          </tr>
        </thead>
        <tbody>
          {
            packages.map((pkg) => (
              <tr>
                <td><code>{pkg.name}</code></td>
                <td>{pkg.version}</td>
                <td><span class={`status status-${pkg.status}`}>{pkg.status}</span></td>
                <td>{pkg.description}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="links-heading">
    <h2 id="links-heading">Related pages</h2>
    <ul>
      <li><a href="/licenses">License matrix</a> &mdash; per-package SPDX license rationale</li>
      <li><a href="/modules">Modules</a> &mdash; documentation reports for the standalone surface modules (browser extension, CI dashboard, and others)</li>
      <li><a href="/wcag-rules-extended">@ariada-org/wcag-rules-extended</a> &mdash; the core rule pack</li>
    </ul>
  </section>
</Base>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .lede {
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .table-scroll {
    overflow-x: auto;
    margin: 0.5rem 0 1rem;
  }

  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.9rem;
  }

  th,
  td {
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 0.6rem;
    text-align: left;
    vertical-align: top;
  }

  th {
    font-weight: 600;
    color: var(--fg);
    background: var(--bg-elevated);
  }

  td code {
    white-space: nowrap;
  }
</style>
