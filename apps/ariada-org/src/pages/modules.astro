---
import ChannelMatrix from '../components/ChannelMatrix.astro';
import Base from '../layouts/Base.astro';
import snapshot from '../../public/channel-matrix.json';

type IndexChannel = (typeof snapshot.channels)[number];

const normalizeName = (value: string) => value.normalize('NFKD').toLocaleLowerCase('en-US');
const compareChannels = (left: IndexChannel, right: IndexChannel) => {
  const leftName = normalizeName(left.name);
  const rightName = normalizeName(right.name);
  if (leftName < rightName) return -1;
  if (leftName > rightName) return 1;
  return left.number - right.number;
};
const channels = [...snapshot.channels].sort(compareChannels);
const availableLanguage = snapshot.wiki.locales;
const itemListJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': 'https://ariada.org/modules/#module-list',
  url: 'https://ariada.org/modules/',
  name: 'Ariada modules',
  description: 'Public delivery, installation, source-code, and documentation evidence for all Ariada modules.',
  availableLanguage,
  numberOfItems: channels.length,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  itemListElement: channels.map((channel, index) => {
    const url = 'https://ariada.org/modules/' + channel.id.toLowerCase() + '/';
    return {
      '@type': 'ListItem',
      position: index + 1,
      url,
      item: {
        '@type': 'TechArticle',
        '@id': url,
        url,
        name: channel.id + ' ' + channel.name,
        description: channel.description,
        sameAs: channel.wikiUrl,
        inLanguage: 'en',
        availableLanguage,
      },
    };
  }),
}).replace(/</g, '\\u003c');
---

<Base
  title="Modules | Ariada"
  description="Explore 236 Ariada modules with public delivery status, installation availability, source-code evidence, use cases, and Ariada Wiki guides."
>
  <script type="application/ld+json" set:html={itemListJsonLd}></script>

  <header class="modules-header">
    <p class="eyebrow">Public delivery evidence</p>
    <h1>Modules</h1>
    <p>
      Review all 236 modules, their declared public delivery status, latest source activity,
      and verifiable public evidence from one sanitized catalog.
    </p>
  </header>

  <ChannelMatrix />
</Base>

<style>
  .modules-header {
    max-width: 72rem;
    padding-bottom: 1.5rem;
  }

  .modules-header .eyebrow {
    margin: 0 0 0.55rem;
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .modules-header h1 {
    margin: 0;
  }

  .modules-header p:last-child {
    max-width: 68ch;
    margin: 0.75rem 0 0;
    color: var(--muted);
    line-height: 1.65;
  }
</style>
