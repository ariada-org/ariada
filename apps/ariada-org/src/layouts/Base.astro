---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
// `path` (without trailing slash) drives aria-current navigation logic.
// `canonicalPath` (always trailing slash for non-root) drives the rel=canonical
// link, because Cloudflare Pages 308-redirects /foo to /foo/ — the canonical
// must match the URL that actually 200s, not the URL that redirects.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalPath = path === "/" ? "/" : `${path}/`;
const url = canonical ?? new URL(canonicalPath, Astro.site).toString();

function current(href: string): "page" | undefined {
  if (href === "/") return path === "/" ? "page" : undefined;
  return path === href || path.startsWith(href + "/") ? "page" : undefined;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0e10" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content="Astro" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="ariada.org" />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ariada.org — open-source rule packs for European web accessibility" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site).toString()} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>

    <header>
      <div class="inner">
        <a href="/" class="brand">ariada.org</a>
        <nav aria-label="Primary">
          <a href="/" aria-current={current("/")}>Home</a>
          <a href="/wcag-rules-extended" aria-current={current("/wcag-rules-extended")}>Packages</a>
          <a href="/pipeline" aria-current={current("/pipeline")}>Pipeline</a>
          <a href="/modules" aria-current={current("/modules")}>Modules</a>
          <a href="/about" aria-current={current("/about")}>About</a>
          <a href="/accessibility" aria-current={current("/accessibility")}>Accessibility</a>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer>
      <div class="inner">
        <nav aria-label="Footer">
          <ul class="footer-links">
            <li>Source: <a href="https://github.com/ariada-org/ariada" rel="external">github.com/ariada-org/ariada</a></li>
            <li>npm: <code>@ariada-org/wcag-rules-extended</code> (v0.1 release candidate)</li>
            <li class="footer-accessibility"><a href="/accessibility">Accessibility</a></li>
          </ul>
        </nav>
        <p class="footer-copyright">
          &copy; {new Date().getFullYear()} Alexander Brichkin (Agonist Development AB). Source under
          <a href="https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12" rel="external">EUPL-1.2</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
