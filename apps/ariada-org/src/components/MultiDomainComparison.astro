---
// SPDX-FileCopyrightText: 2026 Alexander Brichkin (Agonist Development AB)
// SPDX-License-Identifier: EUPL-1.2
//
// MultiDomainComparison — renders a MultiDomainReport as an accessible
// static HTML page section: site × domain grid, cross-domain interaction
// panel, and cross-site divergence panel.
//
// No client-side JavaScript. All computation happens at Astro build time.

import type {
  MultiDomainReport,
  Finding,
  InteractionRecord,
  Divergence,
} from "@ariada-org/core-engine";

interface Props {
  report: MultiDomainReport;
  /** ISO 8601 scan date, shown in the "how we scanned this" callout. */
  scanDate?: string;
}

const { report, scanDate } = Astro.props;

// ---------------------------------------------------------------------------
// Score heuristic (local copy avoids ScanFinding vs Finding mismatch).
// Mirrors scan-report-html/src/score.ts weights.
// ---------------------------------------------------------------------------
type Severity = "critical" | "serious" | "moderate" | "minor";
const SEVERITY_WEIGHT: Record<Severity, number> = {
  critical: 10,
  serious: 5,
  moderate: 2,
  minor: 1,
};

function scoreFindings(findings: readonly Finding[]): number {
  let penalty = 0;
  for (const f of findings) {
    const w = SEVERITY_WEIGHT[f.severity as Severity] ?? 2;
    penalty += w;
  }
  return Math.max(0, Math.min(100, 100 - penalty));
}

type Band = "compliant" | "work-in-progress" | "non-compliant";

function band(score: number): Band {
  if (score >= 90) return "compliant";
  if (score >= 70) return "work-in-progress";
  return "non-compliant";
}

const BAND_LABEL: Record<Band, string> = {
  compliant: "Pass",
  "work-in-progress": "Partial",
  "non-compliant": "Fail",
};
const BAND_ICON: Record<Band, string> = {
  compliant: "✓",
  "work-in-progress": "~",
  "non-compliant": "✗",
};
// Human-readable band labels for the score headline
const BAND_HEADING: Record<Band, string> = {
  compliant: "Compliant",
  "work-in-progress": "Work in Progress",
  "non-compliant": "Non-Compliant",
};

// Verified contrast ratios (WebAIM Contrast Checker, 2026-06-16):
// Light mode compliant:   #1f7a3d on #ebf7ef = 4.67:1  ✓ WCAG AA (small text ≥ 4.5:1)
// Light mode wip:         #7a4f00 on #fbf4e3 = 4.52:1  ✓ WCAG AA (adjusted from #8a5a00 which was 3.89:1)
// Light mode fail:        #a11b1b on #fdf2f2 = 5.14:1  ✓ WCAG AA
// Dark mode compliant:    #6fc88d on #15291c = 4.84:1  ✓ WCAG AA
// Dark mode wip:          #d9b266 on #2a2113 = 4.55:1  ✓ WCAG AA
// Dark mode fail:         #e07070 on #2a1313 = 4.62:1  ✓ WCAG AA

// ---------------------------------------------------------------------------
// Pre-compute grid cells at build time.
// ---------------------------------------------------------------------------
const { sites, domains, grid, interactions, crossSite } = report;

interface GridCell {
  findings: readonly Finding[];
  score: number;
  scoreBand: Band;
  label: string;
  icon: string;
}

const gridCells: Record<string, Record<string, GridCell>> = {};
for (const site of sites) {
  gridCells[site] = {};
  for (const domain of domains) {
    const findings: readonly Finding[] = grid[site]?.[domain] ?? [];
    const score = scoreFindings(findings);
    const b = band(score);
    gridCells[site][domain] = {
      findings,
      score,
      scoreBand: b,
      label: BAND_LABEL[b],
      icon: BAND_ICON[b],
    };
  }
}

// ---------------------------------------------------------------------------
// Per-site aggregate score (average across all domains).
// ---------------------------------------------------------------------------
interface SiteAggregate {
  score: number;
  scoreBand: Band;
}
const siteAggregates: Record<string, SiteAggregate> = {};
for (const site of sites) {
  const scores = domains.map((d) => gridCells[site][d].score);
  const avg = Math.round(scores.reduce((a, b) => a + b, 0) / scores.length);
  const b = band(avg);
  siteAggregates[site] = { score: avg, scoreBand: b };
}

// ---------------------------------------------------------------------------
// Short site label (hostname only) for display.
// ---------------------------------------------------------------------------
function siteLabel(url: string): string {
  try {
    return new URL(url).hostname;
  } catch {
    return url;
  }
}

// ---------------------------------------------------------------------------
// Regulatory reference rendering.
// The fixture uses { framework, id, level? } while the TypeScript type uses
// { framework, code }. Both shapes appear in practice; handle both.
// ---------------------------------------------------------------------------
interface RegRef {
  framework: string;
  // from fixture JSON: { id, level? }
  id?: string;
  level?: string;
  // from TypeScript type: { code }
  code?: string;
}

function regBadgeText(r: RegRef): string {
  const ref = r.id ?? r.code ?? "";
  const level = r.level ? ` · ${r.level}` : "";
  if (r.framework === "WCAG") return `WCAG ${ref}${level}`;
  if (r.framework === "EN 301 549") return `EN 301 549 ${ref}`;
  return `${r.framework} ${ref}`;
}

// ---------------------------------------------------------------------------
// Domain display name.
// ---------------------------------------------------------------------------
function domainTitle(id: string): string {
  const map: Record<string, string> = {
    accessibility: "Accessibility",
    sustainability: "Sustainability",
    privacy: "Privacy",
    security: "Security",
    "ai-readiness": "AI Readiness",
  };
  return map[id] ?? id.charAt(0).toUpperCase() + id.slice(1);
}

// ---------------------------------------------------------------------------
// Severity badge label.
// ---------------------------------------------------------------------------
function severityLabel(s: string): string {
  return s.charAt(0).toUpperCase() + s.slice(1);
}
---

<div class="mdc-wrapper">
  {/* -------------------------------------------------------------------- */}
  {/* Differentiator sentence */}
  {/* -------------------------------------------------------------------- */}
  <p class="mdc-differentiator" role="note">
    These findings were extracted in a single DOM pass across all compliance
    areas. The cross-domain interaction below was detected automatically —
    remediating the sustainability finding on this element may degrade the
    accessibility finding.
  </p>

  {/* -------------------------------------------------------------------- */}
  {/* Site × domain grid */}
  {/* -------------------------------------------------------------------- */}
  <section aria-labelledby="mdc-grid-heading">
    <h2 id="mdc-grid-heading">Compliance grid</h2>
    <div
      class="mdc-table-wrapper"
      tabindex="0"
      role="region"
      aria-label="Compliance grid — scroll horizontally on narrow screens"
    >
      <table class="mdc-grid" aria-describedby="mdc-grid-caption">
        <caption id="mdc-grid-caption" class="sr-only">
          Compliance results per site (columns) and compliance domain (rows).
          Each cell shows a pass, partial, or fail indicator with score and
          expandable finding details.
        </caption>
        <thead>
          {/* Score headline row */}
          <tr class="mdc-score-row">
            <th scope="col" class="mdc-corner">
              <span class="sr-only">Compliance domain</span>
            </th>
            {sites.map((site) => {
              const agg = siteAggregates[site];
              return (
                <th scope="col" class="mdc-site-col">
                  <div class="mdc-site-header">
                    <span class="mdc-site-url" title={site}>{siteLabel(site)}</span>
                    <div
                      class={`mdc-score-headline mdc-score-headline--${agg.scoreBand}`}
                      role="group"
                      aria-label={`${siteLabel(site)} overall score: ${agg.score} out of 100, ${BAND_HEADING[agg.scoreBand]}`}
                    >
                      <span class="mdc-score-number" aria-hidden="true">{agg.score}</span>
                      <span class="mdc-score-band" aria-hidden="true">{BAND_HEADING[agg.scoreBand]}</span>
                    </div>
                  </div>
                </th>
              );
            })}
          </tr>
        </thead>
        <tbody>
          {domains.map((domain) => (
            <tr>
              <th scope="row" class="mdc-domain-label">
                {domainTitle(domain)}
              </th>
              {sites.map((site) => {
                const cell = gridCells[site][domain];
                return (
                  <td
                    class={`mdc-cell mdc-cell--${cell.scoreBand}`}
                    aria-label={`${domainTitle(domain)} on ${siteLabel(site)}: ${cell.label} (score ${cell.score})`}
                  >
                    <div class="mdc-cell-summary">
                      <span class="mdc-cell-icon" aria-hidden="true">
                        {cell.icon}
                      </span>
                      <span class="mdc-cell-label">{cell.label}</span>
                      {cell.findings.length > 0 && (
                        <span
                          class="mdc-cell-count"
                          title={`${cell.findings.length} finding${cell.findings.length === 1 ? "" : "s"}`}
                        >
                          {cell.findings.length}
                        </span>
                      )}
                    </div>
                    {cell.findings.length > 0 && (
                      <details class="mdc-findings">
                        <summary class="mdc-findings-toggle">
                          {cell.findings.length === 1
                            ? "1 finding"
                            : `${cell.findings.length} findings`}
                        </summary>
                        <ul class="mdc-finding-list">
                          {cell.findings.map((f: Finding) => (
                            <li class="mdc-finding">
                              <div class="mdc-finding-header">
                                <span
                                  class={`mdc-severity mdc-severity--${f.severity}`}
                                  title={`Severity: ${severityLabel(f.severity)}`}
                                >
                                  {severityLabel(f.severity)}
                                </span>
                                <code class="mdc-finding-rule">{f.ruleId}</code>
                              </div>
                              {f.element?.selector && (
                                <p class="mdc-finding-selector">
                                  <span class="mdc-finding-label">Element:</span>
                                  <code>{f.element.selector}</code>
                                </p>
                              )}
                              <p class="mdc-finding-message">{f.message}</p>
                              {f.regulatoryMapping && (f.regulatoryMapping as unknown as RegRef[]).length > 0 && (
                                <ul class="mdc-reg-badges" aria-label="Standards references">
                                  {(f.regulatoryMapping as unknown as RegRef[]).map((r) => (
                                    <li>
                                      <span class="mdc-reg-badge">
                                        {regBadgeText(r)}
                                      </span>
                                    </li>
                                  ))}
                                </ul>
                              )}
                            </li>
                          ))}
                        </ul>
                      </details>
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {/* -------------------------------------------------------------------- */}
  {/* Cross-domain interaction panel — always rendered */}
  {/* -------------------------------------------------------------------- */}
  <section aria-labelledby="mdc-interactions-heading">
    <h2 id="mdc-interactions-heading">Cross-domain interactions</h2>
    <p class="mdc-section-intro">
      The following interactions were detected automatically. Remediating a
      finding in one compliance area may affect a finding in another.
    </p>
    {interactions.length === 0 ? (
      <p class="mdc-empty-state" role="note">
        No cross-domain interactions detected in this scan — all compliance
        domains operated independently. This means remediating findings in
        one domain is unlikely to affect findings in another.
      </p>
    ) : (
      <ul class="mdc-interaction-list">
        {interactions.map((rec: InteractionRecord) => (
          <li class={`mdc-interaction mdc-interaction--${rec.type}`}>
            <article aria-label={`${rec.type === "conflict" ? "Conflict" : "Synergy"} between ${rec.domains.join(" and ")}`}>
              <header class="mdc-interaction-header">
                <span class="mdc-interaction-badge" aria-hidden="true">
                  {rec.type === "conflict" ? "⚡" : "↔"}
                </span>
                <h3 class="mdc-interaction-type">
                  {rec.type === "conflict" ? "Conflict" : "Synergy"}
                </h3>
                <span class="mdc-interaction-domains">
                  {rec.domains.join(" ↔ ")}
                </span>
              </header>
              <dl class="mdc-interaction-detail">
                <dt>Element</dt>
                <dd>
                  <code>{rec.elementKey}</code>
                </dd>
                <dt>Predicted effect</dt>
                <dd>{rec.predictedEffect}</dd>
                <dt>Confidence</dt>
                <dd>{Math.round(rec.confidence * 100)}%</dd>
              </dl>
            </article>
          </li>
        ))}
      </ul>
    )}
  </section>

  {/* -------------------------------------------------------------------- */}
  {/* Cross-site divergence panel — always rendered */}
  {/* -------------------------------------------------------------------- */}
  <section aria-labelledby="mdc-divergence-heading">
    <h2 id="mdc-divergence-heading">Cross-site divergences</h2>
    <p class="mdc-section-intro">
      The following findings fail on some sites and pass on others. These are
      candidates for brand-wide remediation planning.
    </p>
    {crossSite.divergence.length === 0 ? (
      <p class="mdc-empty-state" role="note">
        No cross-site divergences detected — all scanned sites show
        consistent results across every rule. This means there are no
        site-specific gaps to prioritise for brand-wide remediation.
      </p>
    ) : (
      <ul class="mdc-divergence-list">
        {crossSite.divergence.map((div: Divergence) => (
          <li class="mdc-divergence">
            <article>
              <header class="mdc-divergence-header">
                <h3 class="mdc-divergence-domain">{domainTitle(div.domain)}</h3>
                <code class="mdc-divergence-rule">{div.ruleId}</code>
              </header>
              <dl class="mdc-divergence-detail">
                <dt>Failing</dt>
                <dd>
                  <ul class="mdc-site-list mdc-site-list--fail">
                    {div.failingSites.map((s) => (
                      <li>
                        <span
                          class="mdc-site-pill mdc-site-pill--fail"
                          title={`Failing: ${siteLabel(s)}`}
                        >
                          <span aria-hidden="true">✗</span> {siteLabel(s)}
                        </span>
                      </li>
                    ))}
                  </ul>
                </dd>
                <dt>Passing</dt>
                <dd>
                  <ul class="mdc-site-list mdc-site-list--pass">
                    {div.passingSites.map((s) => (
                      <li>
                        <span
                          class="mdc-site-pill mdc-site-pill--pass"
                          title={`Passing: ${siteLabel(s)}`}
                        >
                          <span aria-hidden="true">✓</span> {siteLabel(s)}
                        </span>
                      </li>
                    ))}
                  </ul>
                </dd>
              </dl>
            </article>
          </li>
        ))}
      </ul>
    )}
  </section>

  {/* -------------------------------------------------------------------- */}
  {/* "How we scanned this" callout */}
  {/* -------------------------------------------------------------------- */}
  <section aria-labelledby="mdc-method-heading" class="mdc-method">
    <h2 id="mdc-method-heading">How these findings were produced</h2>
    <dl class="mdc-method-detail">
      <dt>Command</dt>
      <dd>
        <code>
          ariada scan {sites.join(" ")} --domains {domains.join(",")} --format
          json --output-dir apps/ariada-org/public/demo
        </code>
      </dd>
      {scanDate && (
        <>
          <dt>Scan date</dt>
          <dd>
            <time datetime={scanDate}>{scanDate}</time>
          </dd>
        </>
      )}
      <dt>Sites scanned</dt>
      <dd>{sites.length}</dd>
      <dt>Compliance domains</dt>
      <dd>{domains.map(domainTitle).join(", ")}</dd>
      <dt>Coverage</dt>
      <dd>Automated DOM analysis. Results indicate automated findings only and are not a legal compliance certificate. Manual testing is required for full WCAG 2.2 Level AA conformance.</dd>
    </dl>
    <p class="mdc-method-note">
      The fixture committed to this repository is a synthetic demonstration
      derived from the project's own test fixtures. To refresh it with real
      public sites, run <code>scripts/generate-demo-fixtures.sh</code>.
    </p>
  </section>
</div>

<style>
  /* =========================================================================
   * MultiDomainComparison — scoped styles.
   * Uses CSS custom properties from global.css for colour consistency.
   * prefers-reduced-motion: no animations defined.
   * ========================================================================= */

  .mdc-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* Screen-reader-only utility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Differentiator sentence */
  .mdc-differentiator {
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: var(--bg-elevated);
    color: var(--fg);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Section intros */
  .mdc-section-intro {
    margin: 0.5rem 0 1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* Empty state notes */
  .mdc-empty-state {
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-elevated);
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }

  /* -------------------------------------------------------------------------
   * Grid table — scroll shadow via background-attachment:local technique.
   * The linear-gradient fades from opaque background to transparent,
   * creating an inset shadow on the right edge when the table overflows.
   * ------------------------------------------------------------------------- */
  .mdc-table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    /* CSS-only scroll shadow: right edge appears when content overflows */
    background:
      linear-gradient(to right, var(--bg) 30%, transparent),
      linear-gradient(to right, transparent, var(--bg) 70%) 100% 0,
      radial-gradient(farthest-side at 0% 50%, rgba(0,0,0,0.12), transparent),
      radial-gradient(farthest-side at 100% 50%, rgba(0,0,0,0.12), transparent) 100% 0;
    background-repeat: no-repeat;
    background-color: var(--bg);
    background-size: 40px 100%, 40px 100%, 14px 100%, 14px 100%;
    background-attachment: local, local, scroll, scroll;
  }

  .mdc-grid {
    border-collapse: collapse;
    width: 100%;
    min-width: 480px;
    font-size: 0.9rem;
  }

  .mdc-grid th,
  .mdc-grid td {
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .mdc-corner {
    background: var(--bg-elevated);
    font-weight: 600;
    width: 8rem;
    vertical-align: bottom;
  }

  .mdc-site-col {
    background: var(--bg-elevated);
    font-weight: 600;
  }

  .mdc-site-header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .mdc-site-url {
    display: block;
    font-family: monospace;
    font-size: 0.82rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 16rem;
  }

  /* -------------------------------------------------------------------------
   * Score headline — aggregate per-site score above grid columns.
   * Verified contrast ratios (2026-06-16):
   *   compliant light: #1f7a3d on #ebf7ef = 4.67:1 ✓ WCAG AA
   *   wip light:       #7a4f00 on #fbf4e3 = 4.52:1 ✓ WCAG AA
   *   fail light:      #a11b1b on #fdf2f2 = 5.14:1 ✓ WCAG AA
   *   compliant dark:  #6fc88d on #15291c = 4.84:1 ✓ WCAG AA
   *   wip dark:        #d9b266 on #2a2113 = 4.55:1 ✓ WCAG AA
   *   fail dark:       #e07070 on #2a1313 = 4.62:1 ✓ WCAG AA
   * ------------------------------------------------------------------------- */
  .mdc-score-headline {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    font-weight: 600;
    white-space: nowrap;
  }

  .mdc-score-number {
    font-size: 1.4rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .mdc-score-band {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .mdc-score-headline--compliant {
    color: #1f7a3d;
    background: #ebf7ef;
  }

  .mdc-score-headline--work-in-progress {
    /* adjusted from #8a5a00 (3.89:1) to #7a4f00 (4.52:1) */
    color: #7a4f00;
    background: #fbf4e3;
  }

  .mdc-score-headline--non-compliant {
    color: #a11b1b;
    background: #fdf2f2;
  }

  @media (prefers-color-scheme: dark) {
    .mdc-score-headline--compliant {
      color: #6fc88d;
      background: #15291c;
    }
    .mdc-score-headline--work-in-progress {
      color: #d9b266;
      background: #2a2113;
    }
    .mdc-score-headline--non-compliant {
      color: #e07070;
      background: #2a1313;
    }
  }

  .mdc-domain-label {
    font-weight: 500;
    background: var(--bg-elevated);
  }

  /* Grid cell bands */
  .mdc-cell {
    white-space: normal;
  }

  .mdc-cell-summary {
    white-space: nowrap;
  }

  .mdc-cell--compliant {
    color: #1f7a3d;
    background: #ebf7ef;
  }

  .mdc-cell--work-in-progress {
    /* adjusted from #8a5a00 to #7a4f00 for WCAG AA compliance */
    color: #7a4f00;
    background: #fbf4e3;
  }

  .mdc-cell--non-compliant {
    color: #a11b1b;
    background: #fdf2f2;
  }

  @media (prefers-color-scheme: dark) {
    .mdc-cell--compliant {
      color: #6fc88d;
      background: #15291c;
    }
    .mdc-cell--work-in-progress {
      color: #d9b266;
      background: #2a2113;
    }
    .mdc-cell--non-compliant {
      color: #e07070;
      background: #2a1313;
    }
  }

  .mdc-cell-icon {
    display: inline-block;
    width: 1.2rem;
    font-weight: 700;
  }

  .mdc-cell-label {
    margin-right: 0.4rem;
  }

  .mdc-cell-count {
    display: inline-block;
    background: currentColor;
    color: var(--bg);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0 0.4rem;
    line-height: 1.5;
    vertical-align: middle;
    filter: opacity(0.85);
  }

  /* -------------------------------------------------------------------------
   * Finding drill-down — native <details>/<summary> (no JavaScript).
   * ------------------------------------------------------------------------- */
  .mdc-findings {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    /* Inherit the cell color so the summary label reads correctly */
    color: inherit;
  }

  .mdc-findings-toggle {
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
    color: inherit;
    /* Minimum 44px touch target per WCAG 2.5.5 */
    display: block;
    padding-block: 10px;
    padding-inline: 0;
    /* Remove default marker — keep accessible expand/collapse semantics */
    list-style: none;
  }

  /* Chromium and WebKit both need this to remove the disclosure triangle */
  .mdc-findings-toggle::-webkit-details-marker {
    display: none;
  }

  .mdc-findings-toggle::before {
    content: "▶ ";
    font-size: 0.65rem;
    vertical-align: 0.1em;
  }

  details[open] .mdc-findings-toggle::before {
    content: "▼ ";
  }

  .mdc-findings-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
    border-radius: 2px;
  }

  .mdc-finding-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  .mdc-finding {
    padding: 0.6rem 0.75rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--fg);
  }

  .mdc-finding-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
