{
  "name": "adopta-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9.15"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "axe-core",
    "scanner",
    "playwright",
    "monorepo",
    "typescript",
    "cloudflare-pages",
    "patent-anchored"
  ],
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "pnpm -F @adopta/integration-tests test",
    "a11y:ci": "turbo run a11y:ci",
    "audit:patent-coverage": "bash scripts/audit-patent-coverage.sh",
    "attw": "pnpm --filter '!@ariada/brand-tokens' --filter '!@ariada/test-fixtures' --filter '!@ariada/eaa-pipeline-meta' -r exec attw --pack --profile node16 || true",
    "publint": "pnpm -r exec publint || true",
    "knip": "knip --include files,exports,dependencies,unlisted || true",
    "madge:circular": "madge --circular --extensions ts,tsx $(ls -d packages apps services 2>/dev/null | tr '\\n' ' ') || true",
    "madge:summary": "madge --summary --extensions ts,tsx packages",
    "alex:prose": "for f in docs/PLATFORM_SPEC.md docs/REGULATORY_CONTEXT.md README.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md; do [ -f \"$f\" ] && alex \"$f\" || true; done",
    "audit:deps": "audit-ci --high",
    "clean": "turbo run clean && rimraf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/cli": "^2.27.10",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/eslint-plugin": "^1.6.17",
    "alex": "^11.0.1",
    "audit-ci": "^7.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^56.0.1",
    "fast-check": "^4.8.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "knip": "^6.14.1",
    "lint-staged": "^15.5.0",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "publint": "^0.3.21",
    "rimraf": "^6.0.1",
    "supports-color": "^10.2.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
