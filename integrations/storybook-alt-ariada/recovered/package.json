{
  "name": "@ariada-integrations/storybook-alt-ariada",
  "version": "0.1.0",
  "description": "Headless Ariada accessibility runner and setup contracts for Histoire and Ladle stories.",
  "license": "EUPL-1.2",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ariada-stories": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./histoire": {
      "types": "./dist/histoire.d.ts",
      "import": "./dist/histoire.js"
    },
    "./schema": "./schema/storybook-alt-ariada-report.schema.json"
  },
  "files": [
    "dist",
    "examples",
    "schema",
    "templates",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "PRODUCTION-AUDIT.md",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs/promises').then(fs => Promise.all(['dist','coverage'].map(path => fs.rm(path,{recursive:true,force:true}))))\"",
    "build": "tsc -p tsconfig.build.json && node -e \"import('node:fs').then(fs=>fs.chmodSync('dist/cli.js',0o755))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts templates examples --max-warnings=0",
    "test": "vitest run",
    "fixtures:build": "node scripts/build-fixtures.mjs",
    "docs": "node scripts/docs-check.mjs",
    "content": "node scripts/content-check.mjs",
    "security": "node scripts/security-check.mjs && npm audit --omit=dev --audit-level=high",
    "source-clean": "node scripts/source-clean.mjs",
    "package": "npm run build && npm run fixtures:build && node scripts/package.mjs",
    "test:packed:offline": "node scripts/packed-consumer.mjs --skip-browser",
    "test:packed": "node scripts/packed-consumer.mjs",
    "check:static": "npm run lint && npm run typecheck && npm run test && npm run build && npm run docs && npm run content && npm run security",
    "check": "npm run source-clean && npm run check:static && npm run package && npm run test:packed"
  },
  "dependencies": {
    "@ariada-org/cli": "0.1.0",
    "@ariada-org/core": "0.1.0",
    "@ariada-org/core-engine": "0.1.0",
    "@ariada-org/core-playwright": "0.1.0",
    "@ariada-org/rules-axe": "0.1.0",
    "@axe-core/playwright": "4.12.1",
    "axe-core": "4.12.1",
    "playwright": "1.61.1"
  },
  "bundleDependencies": [
    "@ariada-org/cli",
    "@ariada-org/core",
    "@ariada-org/core-engine",
    "@ariada-org/core-playwright",
    "@ariada-org/rules-axe",
    "@axe-core/playwright",
    "axe-core",
    "playwright"
  ],
  "peerDependencies": {
    "@ladle/react": "5.1.1",
    "histoire": "1.0.0-beta.1"
  },
  "peerDependenciesMeta": {
    "@ladle/react": {
      "optional": true
    },
    "histoire": {
      "optional": true
    }
  },
  "overrides": {
    "axe-core": "4.12.1",
    "playwright": "1.61.1",
    "playwright-core": "1.61.1",
    "vite": "7.3.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@histoire/plugin-vue": "1.0.0-beta.1",
    "@ladle/react": "5.1.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "9.39.2",
    "histoire": "1.0.0-beta.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vite": "7.3.5",
    "vitest": "4.1.0",
    "vue": "3.5.39"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariada-org/ariada.git",
    "directory": "integrations/storybook-alt-ariada"
  },
  "homepage": "https://github.com/ariada-org/ariada/tree/main/integrations/storybook-alt-ariada",
  "bugs": {
    "url": "https://github.com/ariada-org/ariada/issues"
  },
  "keywords": [
    "histoire",
    "ladle",
    "accessibility",
    "a11y",
    "shadow-dom",
    "wcag",
    "ariada"
  ]
}
