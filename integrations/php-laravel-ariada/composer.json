{
 "name": "ariada/laravel-accessibility",
 "description": "Composer package and Laravel Artisan integration for running Ariada accessibility scans through the shared @ariada-org CLI.",
 "type": "library",
 "license": "EUPL-1.2",
 "authors": [
 {
 "name": "Alexander Brichkin (Agonist Development AB)",
 "email": "git@ariada.org",
 "homepage": "https://ariada.org"
 }
 ],
 "require": {
 "php": ">=8.1",
 "illuminate/console": "^10.0 || ^11.0 || ^12.0",
 "illuminate/contracts": "^10.0 || ^11.0 || ^12.0",
 "illuminate/support": "^10.0 || ^11.0 || ^12.0"
 },
 "require-dev": {
 "laravel/pint": "^1.18",
 "mockery/mockery": "^1.6",
 "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
 "phpunit/phpunit": "^10.5 || ^11.0"
 },
 "autoload": {
 "psr-4": {
 "Ariada\\LaravelAccessibility\\": "src/"
 }
 },
 "autoload-dev": {
 "psr-4": {
 "Ariada\\LaravelAccessibility\\Tests\\": "tests/"
 }
 },
 "extra": {
 "laravel": {
 "providers": [
 "Ariada\\LaravelAccessibility\\Laravel\\AriadaServiceProvider"
 ]
 }
 },
 "scripts": {
 "lint": "pint --test",
 "test": "phpunit",
 "validate:structure": "node scripts/validate-structure.mjs",
 "evidence": "node scripts/generate-evidence.mjs"
 },
 "config": {
 "sort-packages": true,
 "allow-plugins": {
 "pestphp/pest-plugin": false
 }
 },
 "minimum-stability": "stable",
 "prefer-stable": true
}
