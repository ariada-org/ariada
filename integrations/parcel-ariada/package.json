{
  "name": "parcel-reporter-ariada",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parcel reporter adapter for Ariada build-output accessibility scans.",
  "main": "./dist/Reporter.js",
  "types": "./dist/Reporter.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
