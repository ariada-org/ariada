{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.4.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "ariada-prometheus"
        },
        "enable": true,
        "expr": "changes(ariada_gate{url=~\"${url:regex}\"}[5m]) > 0",
        "hide": false,
        "iconColor": "rgba(255, 120, 10, 1)",
        "name": "Gate transitions",
        "step": "5m",
        "tagKeys": "url",
        "textFormat": "Ariada gate changed for {{url}}",
        "titleFormat": "Gate transition"
      }
    ]
  },
  "description": "Ariada accessibility score, gate, scan freshness, and violation breakdowns from the Prometheus contract.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "ariada-prometheus"
      },
      "description": "Accessibility score over time for the selected URLs. Scores below 70 are failing, 70-89 need attention, and 90-100 are healthy.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Ariada score",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 14,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "area"
            }
          },
          "decimals": 1,
          "max": 100,
          "min": 0,
          "noValue": "NO SCORE",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "min", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ariada-prometheus"
          },
          "editorMode": "code",
          "expr": "ariada_score{url=~\"${url:regex}\"}",
          "format": "time_series",
          "instant": false,
          "legendFormat": "{{url}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Ariada Score Trend",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "ariada-prometheus"
      },
      "description": "Current gate result. The dashboard contract maps 1 to PASS and 0 to FAIL.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "FAIL"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "PASS"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "NO GATE",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ariada-prometheus"
          },
          "editorMode": "code",
          "expr": "ariada_gate{url=~\"${url:regex}\"}",
          "format": "time_series",
          "instant": true,
          "legendFormat": "{{url}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Gate State",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "ariada-prometheus"
      },
      "description": "Most recent scan timestamp. Prometheus epoch seconds are converted to milliseconds for Grafana date rendering.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "decimals": 0,
          "mappings": [
            {
              "options": {
                "match": "null",
                "result": {
                  "color": "dark-gray",
                  "index": 0,
                  "text": "NO SCAN"
                }
              },
              "type": "special"
            }
          ],
          "noValue": "NO SCAN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ariada-prometheus"
          },
          "editorMode": "code",
          "expr": "ariada_scan_timestamp{url=~\"${url:regex}\"} * 1000",
          "format": "time_series",
          "instant": true,
          "legendFormat": "{{url}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Last Scan",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "ariada-prometheus"
      },
      "description": "Current violation totals grouped by impact and filtered by URL, impact, and rule.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "min": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "serious"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "moderate"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "minor"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 5,
        "w": 10,
        "x": 14,
        "y": 5
      },
      "id": 4,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ariada-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (impact) (ariada_violations_total{url=~\"${url:regex}\",impact=~\"${impact:regex}\",rule=~\"${rule:regex}\"})",
          "format": "time_series",
          "instant": true,
          "legendFormat": "{{impact}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Violations by Impact",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "ariada-prometheus"
      },
      "description": "Current violation totals grouped by rule and impact, ordered visually by count.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "min": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 5,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ariada-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (rule, impact) (ariada_violations_total{url=~\"${url:regex}\",impact=~\"${impact:regex}\",rule=~\"${rule:regex}\"})",
          "format": "time_series",
          "instant": true,
          "legendFormat": "{{rule}} [{{impact}}]",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Violations by Rule",
      "type": "bargauge"
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["ariada", "accessibility", "s181"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "ariada-prometheus"
        },
        "definition": "label_values(ariada_score, url)",
        "hide": 0,
        "includeAll": true,
        "label": "URL",
        "multi": true,
        "name": "url",
        "options": [],
        "query": {
          "query": "label_values(ariada_score, url)",
          "refId": "PrometheusVariableQueryEditor-URL"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "ariada-prometheus"
        },
        "definition": "label_values(ariada_violations_total{url=~\"${url:regex}\"}, impact)",
        "hide": 0,
        "includeAll": true,
        "label": "Impact",
        "multi": true,
        "name": "impact",
        "options": [],
        "query": {
          "query": "label_values(ariada_violations_total{url=~\"${url:regex}\"}, impact)",
          "refId": "PrometheusVariableQueryEditor-Impact"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "ariada-prometheus"
        },
        "definition": "label_values(ariada_violations_total{url=~\"${url:regex}\",impact=~\"${impact:regex}\"}, rule)",
        "hide": 0,
        "includeAll": true,
        "label": "Rule",
        "multi": true,
        "name": "rule",
        "options": [],
        "query": {
          "query": "label_values(ariada_violations_total{url=~\"${url:regex}\",impact=~\"${impact:regex}\"}, rule)",
          "refId": "PrometheusVariableQueryEditor-Rule"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["1m", "5m", "15m", "30m", "1h"]
  },
  "timezone": "browser",
  "title": "Ariada Accessibility",
  "uid": "ariada-accessibility",
  "version": 1,
  "weekStart": ""
}
