{
  "$schema": "https://v2-9-16.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**", "package.json"],
      "outputs": ["dist/**"]
    },
    "a11y": {
      "dependsOn": ["build"],
      "inputs": ["package.json"],
      "outputs": [".ariada/**"],
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH",
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD"
      ]
    }
  }
}
