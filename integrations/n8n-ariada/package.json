{
  "name": "n8n-nodes-ariada",
  "version": "0.1.0",
  "description": "n8n nodes for Ariada: consume an accessibility report, run the scanner, or start a workflow when a scan completes.",
  "license": "EUPL-1.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ariada-n8n": "dist/cli-entry.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/AriadaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Ariada/Ariada.node.js",
      "dist/triggers/AriadaTrigger/AriadaTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
