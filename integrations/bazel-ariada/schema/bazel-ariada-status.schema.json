{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariada.org/schemas/bazel-ariada-status.v1.json",
  "title": "Ariada Bazel action status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "label",
    "semanticExitCode",
    "actionExitCode",
    "findings",
    "rules",
    "severityThreshold",
    "domains"
  ],
  "properties": {
    "$schema": {
      "const": "https://ariada.org/schemas/bazel-ariada-status.v1.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "semanticExitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "actionExitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "findings": {
      "type": "integer",
      "minimum": 0
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "severityThreshold": {
      "enum": ["minor", "moderate", "serious", "critical"]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "error": {
      "type": "string"
    }
  }
}
