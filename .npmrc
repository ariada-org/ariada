strict-peer-dependencies=false
auto-install-peers=true
dedupe-peer-dependents=true
hoist-pattern[]=*eslint*
hoist-pattern[]=*prettier*
hoist-pattern[]=*typescript*
public-hoist-pattern[]=@ariada-org/*
# Required by apps/docs: TypeDoc resolves its plugins (e.g. typedoc-plugin-markdown)
# from its own package location, not the consuming package's. Without hoisting,
# pnpm's strict layout puts the plugin out of TypeDoc's resolution scope and the
# starlight-typedoc integration throws ERR_MODULE_NOT_FOUND at build time.
public-hoist-pattern[]=typedoc-plugin-*
