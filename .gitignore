# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
out/
.next/
.turbo/
.astro/
.wrangler/
**/*.tsbuildinfo

# salvage migration: filesystem BlobStore default dir for services/backend
var-blobs/

# test artifacts
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# per-package test-runner JSON output, coverage, and turbo cache
packages/**/test-results.json
packages/**/coverage/
packages/**/.turbo/
packages/**/dist/

# SARIF + SBOM scratch
*.sarif
sbom.cdx.json
sbom.spdx.json

# npm pack / tarball artefacts (never commit binary pack output)
*.tgz
*.tar.gz

# logs
*.log
pnpm-debug.log*
yarn-debug.log*
npm-debug.log*

# env (keep .env.example tracked)
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/
*.swp

# LibreOffice / Word lock files (common in docs/grants/patents dirs)
.~lock.*#
~$*
research/output/phase4bd_cache/

# agent worktrees — local-only scratch dirs for background agents
.claude/worktrees/

# Claude Code orchestrator local state (cron jobs, runtime locks)
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock

# Next.js cache nested under any app (root .next/ already covered above)
**/.next/cache/

# Kaggle / dataset scratch (per-phase intermediate state)
data/kaggle/_*_checkpoint.json
data/kaggle/_*_search_results.json

# Editor / shell scratch
*.bak
*.orig

# git-lfs auto-generated husky hooks (per-machine, created by `git lfs install`).
# Other husky hooks (pre-push, etc.) are repo-managed and stay tracked.
# post-commit is tracked: it carries the RAG auto-index call (logic in the
# tracked scripts/rag-postcommit.sh); the committed version is the source of
# truth and is restorable with `git checkout .husky/post-commit` if git-lfs
# regenerates it locally.
.husky/post-checkout
.husky/post-merge

# Local-only patent drafts and raw bulk downloads — pre-publication risk
# plus multi-GB re-fetchable artefacts.
patents/unfiled/
patents/bulk-claims/

# Heavy datasets — removed from git history 2026-05-13 by CANTOR-2 via git filter-repo.
# All re-fetchable from primary sources (PatentsView Q4 2025, Kaggle, DBLP, arXiv, BigQuery).
# .git shrunk 12 GB -> 254 MB after removal. Do not re-commit these paths.
data/
!apps/ariada-wiki/data/
apps/ariada-wiki/data/*
!apps/ariada-wiki/data/channel-matrix.json
research/output/bigquery_claims_*.jsonl
research/baseline/
patentomania/nats-data/

# Local sandbox/experimental git clones (not submodules)
/AutoPatent/
/pqai/

# Research datasets — embedded git repos (large, re-derivable from upstream)
# ChatGPT-Code-Detection = Patent G validation dataset (AI-code-detection benchmark)
/research/poc/*/datasets/ChatGPT-Code-Detection/

# Local build-evidence artefacts (regenerate via scripts/build-evidence-report.mjs)
var/build-evidence/
__pycache__/
var/

# Codex per-machine config (contains API keys — never commit)
.codex/config.toml
.codex/auth.json
